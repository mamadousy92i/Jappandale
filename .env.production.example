# Copiez ce fichier en ".env" à la racine du dépôt sur le VPS, puis remplissez
# chaque valeur. Ce fichier ".env" ne doit JAMAIS être commité (il est dans
# .gitignore) : il contient des secrets réels une fois rempli.

# ---------------------------------------------------------------------------
# Base de données (utilisée par le conteneur "db" ET recomposée automatiquement
# en DATABASE_URL pour le backend dans docker-compose.yml — ne dupliquez rien).
# ---------------------------------------------------------------------------
POSTGRES_DB=jappandale
POSTGRES_USER=jappandale
POSTGRES_PASSWORD=changez-moi-mot-de-passe-long-et-aleatoire

# ---------------------------------------------------------------------------
# Nom de domaine et HTTPS (Caddy)
# ---------------------------------------------------------------------------
# Le domaine doit déjà pointer (enregistrement DNS de type A) vers l'IP du VPS
# avant de démarrer, sinon Caddy ne pourra pas obtenir de certificat HTTPS.
# En test local sans domaine, mettez DOMAIN=localhost (Caddy servira en HTTP
# simple, sans certificat).
DOMAIN=jappandale.sn
CADDY_ACME_EMAIL=contact@yambinternational.com

# ---------------------------------------------------------------------------
# Django — cœur
# ---------------------------------------------------------------------------
SECRET_KEY=changez-moi-cle-longue-et-aleatoire-differente-du-developpement
DEBUG=False
ALLOWED_HOSTS=jappandale.sn
CORS_ALLOWED_ORIGINS=https://jappandale.sn
CSRF_TRUSTED_ORIGINS=https://jappandale.sn
FRONTEND_URL=https://jappandale.sn

# ---------------------------------------------------------------------------
# Cookies & HTTPS — à activer une fois le certificat HTTPS confirmé fonctionnel
# ---------------------------------------------------------------------------
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Caddy fait office de proxy HTTPS devant Django : sans ceci, Django ne sait
# pas que la requête est arrivée en HTTPS et SECURE_SSL_REDIRECT boucle.
TRUST_PROXY_SSL_HEADER=True

# ---------------------------------------------------------------------------
# E-mail (SMTP réel — obligatoire pour l'inscription, le mot de passe oublié,
# le code de sécurité admin, les notifications)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=contact@yambinternational.com
EMAIL_HOST_PASSWORD=changez-moi
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Jappandale <contact@yambinternational.com>
# Chemin du logo à l'intérieur du conteneur backend (voir backend/Dockerfile) :
# ne pas modifier sauf si vous changez la structure de l'image.
EMAIL_LOGO_PATH=/app/assets/logo-mark.png
EMAIL_OTP_TTL=600
ADMIN_MFA_OTP_TTL=600
PASSWORD_RESET_TIMEOUT=3600

# ---------------------------------------------------------------------------
# API interne du Score Jappandale (service à service)
# ---------------------------------------------------------------------------
INTERNAL_API_KEY=changez-moi-cle-longue-et-aleatoire

# ---------------------------------------------------------------------------
# Paiements — NE PAS ACTIVER tant qu'un vrai prestataire (Wave, Orange Money…)
# n'est pas intégré. Voir l'audit de sécurité : ce réglage à True permettrait
# à n'importe qui de valider ses propres paiements sans payer.
# ---------------------------------------------------------------------------
SIMULATED_PAYMENTS_ENABLED=False

# ---------------------------------------------------------------------------
# Journaux
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Réglages internes gunicorn (facultatif)
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=3
